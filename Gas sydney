<!DOCTYPE html>
<html>
<head>
<title>Cheapest Petrol in Sydney</title>

<style>
body{
font-family:Arial;
background:#f2f2f2;
text-align:center;
padding:40px;
}

.card{
background:white;
padding:20px;
margin:20px auto;
width:300px;
border-radius:10px;
box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

.price{
font-size:28px;
color:#0b6efd;
font-weight:bold;
}
</style>

</head>

<body>

<h1>Find Cheapest Petrol in Sydney</h1>

<input id="suburb" placeholder="Enter suburb">
<button onclick="search()">Search</button>

<div id="results"></div>

<script>

const stations = [
{name:"Metro Alexandria",price:171.9,address:"Botany Rd"},
{name:"United Petersham",price:169.9,address:"Parramatta Rd"},
{name:"BP Tempe",price:172.4,address:"Princes Hwy"},
{name:"Shell Five Dock",price:173.1,address:"Parramatta Rd"}
]

function search(){

let results = document.getElementById("results")

results.innerHTML=""

stations.sort((a,b)=>a.price-b.price)

stations.forEach(station=>{

results.innerHTML+=`
<div class="card">
<h3>${station.name}</h3>
<div class="price">${station.price} c/L</div>
<p>${station.address}</p>
</div>
`

})

}

</script>

</body>
</html>
